{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/claude-hooks/memory-conversation/suggest-context.js",
            "timeout": 60,
            "statusMessage": "Searching conversation memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/claude-hooks/memory-conversation/index-conversation.js",
            "timeout": 60,
            "statusMessage": "Indexing conversation to memory"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "memory-conversation": {
      "type": "stdio",
      "command": "node",
      "args": [".claude/claude-hooks/memory-conversation/mcp-server.js"]
    }
  }
}
