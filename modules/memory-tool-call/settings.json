{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/claude-hooks/memory-tool-call/suggest-tool-context.js",
            "timeout": 30,
            "statusMessage": "Checking tool call history"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/claude-hooks/memory-tool-call/record-tool-success.js",
            "timeout": 30,
            "statusMessage": "Recording tool call"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/claude-hooks/memory-tool-call/record-tool-failure.js",
            "timeout": 30,
            "statusMessage": "Recording tool call failure"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "memory-tool-call": {
      "type": "stdio",
      "command": "node",
      "args": [".claude/claude-hooks/memory-tool-call/mcp-server.js"]
    }
  }
}
